# Export these variables in the shell or IDE; Spring Boot does not automatically load .env files.
DB_URL=jdbc:mysql://127.0.0.1:3306/gym_saas?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&characterEncoding=UTF-8
DB_USERNAME=gym_app
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
SERVER_PORT=8080
# Required outside bootstrap: base64 of at least 32 random bytes; never commit the actual value.
JWT_SECRET=
DEV_AUTH_ENABLED=false
DEV_AUTH_KEY=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
