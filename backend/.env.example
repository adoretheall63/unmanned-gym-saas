# 本地开发环境变量（复制为 .env 后使用；.env 已被 .gitignore 忽略）
# 仅用于本机开发数据库，禁止用于生产，禁止提交 .env

# MySQL 端口/库名
MYSQL_PORT=3306
MYSQL_DATABASE=gym_saas

# root 口令（仅本地容器）
MYSQL_ROOT_PASSWORD=root_dev_only

# 应用账号：绑定 gym_app 角色，只追加表不可改（application.yml 用这个）
APP_DB_USER=gym_dev
APP_DB_PASSWORD=dev_only_password

# 测试夹具账号：仅集成测试建/清数据用，禁止配给应用
TEST_DB_USER=gym_test
TEST_DB_PASSWORD=test_only_password

# Redis
REDIS_PORT=6379
