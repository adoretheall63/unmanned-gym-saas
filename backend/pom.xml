<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.5</version>
        <relativePath/>
    </parent>

    <groupId>com.wrgym</groupId>
    <artifactId>gym-saas-backend</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>gym-saas-backend</name>
    <description>无人健身房 SaaS 业务后端（模块化单体）</description>

    <!--
      模块与分支一一对应，模块清单在 feat/be-00-foundation 一次性定型，
      后续每个模块分支只在自身模块目录内改动，避免父 POM 与 gym-common 冲突。
      基础设施：gym-common / gym-security / gym-adapter-* / gym-bootstrap
      业务模块：gym-module-*（对应 docs/接口文档.md §1.5 的 15 个模块 + scheduler）
    -->
    <modules>
        <module>gym-common</module>
        <module>gym-security</module>
        <module>gym-adapter-api</module>
        <module>gym-adapter-mock</module>
        <module>gym-adapter-ezviz</module>
        <module>gym-module-auth</module>
        <module>gym-module-merchant</module>
        <module>gym-module-store</module>
        <module>gym-module-booking</module>
        <module>gym-module-device</module>
        <module>gym-module-visit</module>
        <module>gym-module-billing</module>
        <module>gym-module-customer</module>
        <module>gym-module-card</module>
        <module>gym-module-review</module>
        <module>gym-module-report</module>
        <module>gym-module-lighting</module>
        <module>gym-module-video</module>
        <module>gym-module-face</module>
        <module>gym-module-dev</module>
        <module>gym-module-scheduler</module>
        <module>gym-bootstrap</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mybatis-plus.version>3.5.9</mybatis-plus.version>
        <springdoc.version>2.8.6</springdoc.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-adapter-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-adapter-mock</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-adapter-ezviz</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-merchant</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-store</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-booking</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-device</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-visit</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-billing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-customer</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-card</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-review</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-report</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-lighting</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-video</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-face</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-dev</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.wrgym</groupId>
                <artifactId>gym-module-scheduler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MyBatis-Plus 3.5.9 起 JSqlParser 拆分，分页插件需显式引入 -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-parameters</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
