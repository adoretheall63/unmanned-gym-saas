graph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1, splines=polyline, overlap=false, fontname="Hiragino Sans GB", label="商家与身份", labelloc=t, fontsize=22];
node [fontname="Hiragino Sans GB", fontsize=13, color="#333333", penwidth=1.2];
edge [fontname="Hiragino Sans GB", fontsize=12, color="#555555", penwidth=1.1];
merchant [shape=box, label="商家\nmerchant", margin="0.15,0.10"];
merchant_a0 [shape=ellipse, label=<<U>编号</U>>];
merchant -- merchant_a0 [weight=0.3];
merchant_a1 [shape=ellipse, label="商家名称"];
merchant -- merchant_a1 [weight=0.3];
customer_user [shape=box, label="顾客\ncustomer_user", margin="0.15,0.10"];
customer_user_a0 [shape=ellipse, label=<<U>编号</U>>];
customer_user -- customer_user_a0 [weight=0.3];
customer_user_a1 [shape=ellipse, label="微信身份"];
customer_user -- customer_user_a1 [weight=0.3];
admin_user [shape=box, label="后台员工\nadmin_user", margin="0.15,0.10"];
admin_user_a0 [shape=ellipse, label=<<U>编号</U>>];
admin_user -- admin_user_a0 [weight=0.3];
admin_user_a1 [shape=ellipse, label="角色"];
admin_user -- admin_user_a1 [weight=0.3];
store [shape=box, label="门店\nstore", margin="0.15,0.10"];
store_a0 [shape=ellipse, label=<<U>编号</U>>];
store -- store_a0 [weight=0.3];
store_a1 [shape=ellipse, label="门店名称"];
store -- store_a1 [weight=0.3];
r0 [shape=diamond, label="雇用", margin=0.1];
merchant -- r0 [label="1"];
r0 -- admin_user [label="N"];
r1 [shape=diamond, label="经营", margin=0.1];
merchant -- r1 [label="1"];
r1 -- store [label="N"];
r2 [shape=diamond, label="商家顾客关系", margin=0.1];
merchant -- r2 [label="M"];
r2 -- customer_user [label="N"];
r2_a0 [shape=ellipse, label="黑名单"];
r2 -- r2_a0 [weight=0.3];
r2_a1 [shape=ellipse, label="信用分"];
r2 -- r2_a1 [weight=0.3];
r2_a2 [shape=ellipse, label="预约限制截止"];
r2 -- r2_a2 [weight=0.3];
}
