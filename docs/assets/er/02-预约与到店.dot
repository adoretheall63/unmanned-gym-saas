graph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1, splines=polyline, overlap=false, fontname="Hiragino Sans GB", label="预约与实际到店", labelloc=t, fontsize=22];
node [fontname="Hiragino Sans GB", fontsize=13, color="#333333", penwidth=1.2];
edge [fontname="Hiragino Sans GB", fontsize=12, color="#555555", penwidth=1.1];
store [shape=box, label="门店\nstore", margin="0.15,0.10"];
store_a0 [shape=ellipse, label=<<U>编号</U>>];
store -- store_a0 [weight=0.3];
store_slot [shape=box, label="可预约时段\nstore_slot", margin="0.15,0.10"];
store_slot_a0 [shape=ellipse, label=<<U>编号</U>>];
store_slot -- store_slot_a0 [weight=0.3];
store_slot_a1 [shape=ellipse, label="起止时间"];
store_slot -- store_slot_a1 [weight=0.3];
store_slot_a2 [shape=ellipse, label="容量"];
store_slot -- store_slot_a2 [weight=0.3];
customer_user [shape=box, label="顾客\ncustomer_user", margin="0.15,0.10"];
customer_user_a0 [shape=ellipse, label=<<U>编号</U>>];
customer_user -- customer_user_a0 [weight=0.3];
booking_order [shape=box, label="预约订单\nbooking_order", margin="0.15,0.10"];
booking_order_a0 [shape=ellipse, label=<<U>编号</U>>];
booking_order -- booking_order_a0 [weight=0.3];
booking_order_a1 [shape=ellipse, label="订单状态"];
booking_order -- booking_order_a1 [weight=0.3];
booking_order_a2 [shape=ellipse, label="计费快照"];
booking_order -- booking_order_a2 [weight=0.3];
visit_session [shape=box, label="一次到店\nvisit_session", margin="0.15,0.10"];
visit_session_a0 [shape=ellipse, label=<<U>编号</U>>];
visit_session -- visit_session_a0 [weight=0.3];
visit_session_a1 [shape=ellipse, label="入场时间"];
visit_session -- visit_session_a1 [weight=0.3];
visit_session_a2 [shape=ellipse, label="离场时间"];
visit_session -- visit_session_a2 [weight=0.3];
r0 [shape=diamond, label="提供", margin=0.1];
store -- r0 [label="1"];
r0 -- store_slot [label="N"];
r1 [shape=diamond, label="下单", margin=0.1];
customer_user -- r1 [label="1"];
r1 -- booking_order [label="N"];
r2 [shape=diamond, label="被预约", margin=0.1];
store_slot -- r2 [label="1"];
r2 -- booking_order [label="N"];
r3 [shape=diamond, label="实际到店", margin=0.1];
customer_user -- r3 [label="1"];
r3 -- visit_session [label="N"];
r4 [shape=diamond, label="实际使用", margin=0.1];
visit_session -- r4 [label="0..1"];
r4 -- booking_order [label="N"];
r4_a0 [shape=ellipse, label="使用起点"];
r4 -- r4_a0 [weight=0.3];
r4_a1 [shape=ellipse, label="使用终点"];
r4 -- r4_a1 [weight=0.3];
}
