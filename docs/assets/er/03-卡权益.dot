graph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1, splines=polyline, overlap=false, fontname="Hiragino Sans GB", label="卡产品与顾客权益", labelloc=t, fontsize=22];
node [fontname="Hiragino Sans GB", fontsize=13, color="#333333", penwidth=1.2];
edge [fontname="Hiragino Sans GB", fontsize=12, color="#555555", penwidth=1.1];
merchant [shape=box, label="商家\nmerchant", margin="0.15,0.10"];
merchant_a0 [shape=ellipse, label=<<U>编号</U>>];
merchant -- merchant_a0 [weight=0.3];
customer_user [shape=box, label="顾客\ncustomer_user", margin="0.15,0.10"];
customer_user_a0 [shape=ellipse, label=<<U>编号</U>>];
customer_user -- customer_user_a0 [weight=0.3];
card_product [shape=box, label="卡产品\ncard_product", margin="0.15,0.10"];
card_product_a0 [shape=ellipse, label=<<U>编号</U>>];
card_product -- card_product_a0 [weight=0.3];
card_product_a1 [shape=ellipse, label="卡类型"];
card_product -- card_product_a1 [weight=0.3];
card_product_a2 [shape=ellipse, label="售价"];
card_product -- card_product_a2 [weight=0.3];
member_card [shape=box, label="持有卡\nmember_card", margin="0.15,0.10"];
member_card_a0 [shape=ellipse, label=<<U>编号</U>>];
member_card -- member_card_a0 [weight=0.3];
member_card_a1 [shape=ellipse, label="有效期"];
member_card -- member_card_a1 [weight=0.3];
member_card_a2 [shape=ellipse, label="剩余次数"];
member_card -- member_card_a2 [weight=0.3];
card_ledger [shape=box, label="权益流水\ncard_ledger", margin="0.15,0.10"];
card_ledger_a0 [shape=ellipse, label=<<U>编号</U>>];
card_ledger -- card_ledger_a0 [weight=0.3];
card_ledger_a1 [shape=ellipse, label="变化类型"];
card_ledger -- card_ledger_a1 [weight=0.3];
card_ledger_a2 [shape=ellipse, label="次数变化"];
card_ledger -- card_ledger_a2 [weight=0.3];
booking_order [shape=box, label="预约订单\nbooking_order", margin="0.15,0.10"];
booking_order_a0 [shape=ellipse, label=<<U>编号</U>>];
booking_order -- booking_order_a0 [weight=0.3];
r0 [shape=diamond, label="销售", margin=0.1];
merchant -- r0 [label="1"];
r0 -- card_product [label="N"];
r1 [shape=diamond, label="购买形成", margin=0.1];
card_product -- r1 [label="1"];
r1 -- member_card [label="N"];
r2 [shape=diamond, label="持有", margin=0.1];
customer_user -- r2 [label="1"];
r2 -- member_card [label="N"];
r3 [shape=diamond, label="提供权益", margin=0.1];
member_card -- r3 [label="0..1"];
r3 -- booking_order [label="N"];
r4 [shape=diamond, label="记录变化", margin=0.1];
member_card -- r4 [label="1"];
r4 -- card_ledger [label="N"];
r5 [shape=diamond, label="关联权益", margin=0.1];
booking_order -- r5 [label="0..1"];
r5 -- card_ledger [label="N"];
}
