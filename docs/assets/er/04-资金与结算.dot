graph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1, splines=polyline, overlap=false, fontname="Hiragino Sans GB", label="现金流水与到店结算", labelloc=t, fontsize=22];
node [fontname="Hiragino Sans GB", fontsize=13, color="#333333", penwidth=1.2];
edge [fontname="Hiragino Sans GB", fontsize=12, color="#555555", penwidth=1.1];
booking_order [shape=box, label="预约订单\nbooking_order", margin="0.15,0.10"];
booking_order_a0 [shape=ellipse, label=<<U>编号</U>>];
booking_order -- booking_order_a0 [weight=0.3];
visit_session [shape=box, label="一次到店\nvisit_session", margin="0.15,0.10"];
visit_session_a0 [shape=ellipse, label=<<U>编号</U>>];
visit_session -- visit_session_a0 [weight=0.3];
member_card [shape=box, label="持有卡\nmember_card", margin="0.15,0.10"];
member_card_a0 [shape=ellipse, label=<<U>编号</U>>];
member_card -- member_card_a0 [weight=0.3];
payment_record [shape=box, label="现金流水\npayment_record", margin="0.15,0.10"];
payment_record_a0 [shape=ellipse, label=<<U>编号</U>>];
payment_record -- payment_record_a0 [weight=0.3];
payment_record_a1 [shape=ellipse, label="收款或退款"];
payment_record -- payment_record_a1 [weight=0.3];
payment_record_a2 [shape=ellipse, label="金额"];
payment_record -- payment_record_a2 [weight=0.3];
visit_settlement [shape=box, label="当前结算\nvisit_settlement", margin="0.15,0.10"];
visit_settlement_a0 [shape=ellipse, label=<<U>编号</U>>];
visit_settlement -- visit_settlement_a0 [weight=0.3];
visit_settlement_a1 [shape=ellipse, label="结算状态"];
visit_settlement -- visit_settlement_a1 [weight=0.3];
visit_settlement_a2 [shape=ellipse, label="超时应收"];
visit_settlement -- visit_settlement_a2 [weight=0.3];
settlement_revision [shape=box, label="结算修订\nsettlement_revision", margin="0.15,0.10"];
settlement_revision_a0 [shape=ellipse, label=<<U>编号</U>>];
settlement_revision -- settlement_revision_a0 [weight=0.3];
settlement_revision_a1 [shape=ellipse, label="版本"];
settlement_revision -- settlement_revision_a1 [weight=0.3];
settlement_revision_a2 [shape=ellipse, label="修订原因"];
settlement_revision -- settlement_revision_a2 [weight=0.3];
r0 [shape=diamond, label="形成", margin=0.1];
visit_session -- r0 [label="1"];
r0 -- visit_settlement [label="1"];
r1 [shape=diamond, label="保留版本", margin=0.1];
visit_settlement -- r1 [label="1"];
r1 -- settlement_revision [label="N"];
r2 [shape=diamond, label="预约收退款", margin=0.1];
booking_order -- r2 [label="0..1"];
r2 -- payment_record [label="N"];
r3 [shape=diamond, label="超时收退款", margin=0.1];
visit_session -- r3 [label="0..1"];
r3 -- payment_record [label="N"];
r4 [shape=diamond, label="购卡收退款", margin=0.1];
member_card -- r4 [label="0..1"];
r4 -- payment_record [label="N"];
}
