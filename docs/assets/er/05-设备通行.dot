graph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1, splines=polyline, overlap=false, fontname="Hiragino Sans GB", label="设备与通行", labelloc=t, fontsize=22];
node [fontname="Hiragino Sans GB", fontsize=13, color="#333333", penwidth=1.2];
edge [fontname="Hiragino Sans GB", fontsize=12, color="#555555", penwidth=1.1];
store [shape=box, label="门店\nstore", margin="0.15,0.10"];
store_a0 [shape=ellipse, label=<<U>编号</U>>];
store -- store_a0 [weight=0.3];
device [shape=box, label="设备\ndevice", margin="0.15,0.10"];
device_a0 [shape=ellipse, label=<<U>编号</U>>];
device -- device_a0 [weight=0.3];
device_a1 [shape=ellipse, label="设备类型"];
device -- device_a1 [weight=0.3];
customer_user [shape=box, label="顾客\ncustomer_user", margin="0.15,0.10"];
customer_user_a0 [shape=ellipse, label=<<U>编号</U>>];
customer_user -- customer_user_a0 [weight=0.3];
access_credential [shape=box, label="通行凭证\naccess_credential", margin="0.15,0.10"];
access_credential_a0 [shape=ellipse, label=<<U>编号</U>>];
access_credential -- access_credential_a0 [weight=0.3];
access_credential_a1 [shape=ellipse, label="目标版本"];
access_credential -- access_credential_a1 [weight=0.3];
access_credential_a2 [shape=ellipse, label="观察结果"];
access_credential -- access_credential_a2 [weight=0.3];
credential_window [shape=box, label="有效区间\ncredential_window", margin="0.15,0.10"];
credential_window_a0 [shape=ellipse, label=<<U>编号</U>>];
credential_window -- credential_window_a0 [weight=0.3];
credential_window_a1 [shape=ellipse, label="起止时间"];
credential_window -- credential_window_a1 [weight=0.3];
credential_window_a2 [shape=ellipse, label="版本"];
credential_window -- credential_window_a2 [weight=0.3];
device_operation [shape=box, label="设备命令\ndevice_operation", margin="0.15,0.10"];
device_operation_a0 [shape=ellipse, label=<<U>编号</U>>];
device_operation -- device_operation_a0 [weight=0.3];
device_operation_a1 [shape=ellipse, label="动作"];
device_operation -- device_operation_a1 [weight=0.3];
device_operation_a2 [shape=ellipse, label="执行状态"];
device_operation -- device_operation_a2 [weight=0.3];
device_event [shape=box, label="设备事件\ndevice_event", margin="0.15,0.10"];
device_event_a0 [shape=ellipse, label=<<U>编号</U>>];
device_event -- device_event_a0 [weight=0.3];
device_event_a1 [shape=ellipse, label="发生时间"];
device_event -- device_event_a1 [weight=0.3];
device_event_a2 [shape=ellipse, label="接收时间"];
device_event -- device_event_a2 [weight=0.3];
r0 [shape=diamond, label="安装", margin=0.1];
store -- r0 [label="1"];
r0 -- device [label="N"];
r1 [shape=diamond, label="设备人员映射", margin=0.1];
customer_user -- r1 [label="M"];
r1 -- device [label="N"];
r1_a0 [shape=ellipse, label="设备内人员标识"];
r1 -- r1_a0 [weight=0.3];
r2 [shape=diamond, label="承载", margin=0.1];
device -- r2 [label="1"];
r2 -- access_credential [label="N"];
r3 [shape=diamond, label="拥有", margin=0.1];
customer_user -- r3 [label="1"];
r3 -- access_credential [label="N"];
r4 [shape=diamond, label="规定区间", margin=0.1];
access_credential -- r4 [label="1"];
r4 -- credential_window [label="N"];
r5 [shape=diamond, label="执行", margin=0.1];
device -- r5 [label="1"];
r5 -- device_operation [label="N"];
r6 [shape=diamond, label="同步权限", margin=0.1];
access_credential -- r6 [label="0..1"];
r6 -- device_operation [label="N"];
r7 [shape=diamond, label="报告", margin=0.1];
device -- r7 [label="1"];
r7 -- device_event [label="N"];
r8 [shape=diamond, label="对应结果", margin=0.1];
device_operation -- r8 [label="0..1"];
r8 -- device_event [label="N"];
}
