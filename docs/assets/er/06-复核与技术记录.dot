graph G {
graph [rankdir=LR, bgcolor="white", pad=0.4, nodesep=0.5, ranksep=1, splines=polyline, overlap=false, fontname="Hiragino Sans GB", label="复核审计与辅助记录", labelloc=t, fontsize=22];
node [fontname="Hiragino Sans GB", fontsize=13, color="#333333", penwidth=1.2];
edge [fontname="Hiragino Sans GB", fontsize=12, color="#555555", penwidth=1.1];
merchant [shape=box, label="商家\nmerchant", margin="0.15,0.10"];
merchant_a0 [shape=ellipse, label=<<U>编号</U>>];
merchant -- merchant_a0 [weight=0.3];
admin_user [shape=box, label="后台员工\nadmin_user", margin="0.15,0.10"];
admin_user_a0 [shape=ellipse, label=<<U>编号</U>>];
admin_user -- admin_user_a0 [weight=0.3];
customer_user [shape=box, label="顾客\ncustomer_user", margin="0.15,0.10"];
customer_user_a0 [shape=ellipse, label=<<U>编号</U>>];
customer_user -- customer_user_a0 [weight=0.3];
booking_order [shape=box, label="预约订单\nbooking_order", margin="0.15,0.10"];
booking_order_a0 [shape=ellipse, label=<<U>编号</U>>];
booking_order -- booking_order_a0 [weight=0.3];
credit_event [shape=box, label="信用事件\ncredit_event", margin="0.15,0.10"];
credit_event_a0 [shape=ellipse, label=<<U>编号</U>>];
credit_event -- credit_event_a0 [weight=0.3];
credit_event_a1 [shape=ellipse, label="分数变化"];
credit_event -- credit_event_a1 [weight=0.3];
review_task [shape=box, label="复核待办\nreview_task", margin="0.15,0.10"];
review_task_a0 [shape=ellipse, label=<<U>编号</U>>];
review_task -- review_task_a0 [weight=0.3];
review_task_a1 [shape=ellipse, label="处理状态"];
review_task -- review_task_a1 [weight=0.3];
business_event [shape=box, label="业务审计\nbusiness_event", margin="0.15,0.10"];
business_event_a0 [shape=ellipse, label=<<U>编号</U>>];
business_event -- business_event_a0 [weight=0.3];
business_event_a1 [shape=ellipse, label="动作"];
business_event -- business_event_a1 [weight=0.3];
business_event_a2 [shape=ellipse, label="原因"];
business_event -- business_event_a2 [weight=0.3];
face_profile [shape=box, label="可选人脸资料\nface_profile", margin="0.15,0.10"];
face_profile_a0 [shape=ellipse, label=<<U>编号</U>>];
face_profile -- face_profile_a0 [weight=0.3];
face_profile_a1 [shape=ellipse, label="授权时间"];
face_profile -- face_profile_a1 [weight=0.3];
face_profile_a2 [shape=ellipse, label="删除状态"];
face_profile -- face_profile_a2 [weight=0.3];
api_request [shape=box, label="请求幂等记录\napi_request", margin="0.15,0.10"];
api_request_a0 [shape=ellipse, label=<<U>编号</U>>];
api_request -- api_request_a0 [weight=0.3];
api_request_a1 [shape=ellipse, label="请求哈希"];
api_request -- api_request_a1 [weight=0.3];
api_request_a2 [shape=ellipse, label="幂等键"];
api_request -- api_request_a2 [weight=0.3];
r0 [shape=diamond, label="产生信用变化", margin=0.1];
booking_order -- r0 [label="1"];
r0 -- credit_event [label="N"];
r1 [shape=diamond, label="接收待办", margin=0.1];
merchant -- r1 [label="1"];
r1 -- review_task [label="N"];
r2 [shape=diamond, label="处理", margin=0.1];
admin_user -- r2 [label="0..1"];
r2 -- review_task [label="N"];
r3 [shape=diamond, label="保存审计", margin=0.1];
merchant -- r3 [label="1"];
r3 -- business_event [label="N"];
r4 [shape=diamond, label="执行操作", margin=0.1];
admin_user -- r4 [label="0..1"];
r4 -- business_event [label="N"];
r5 [shape=diamond, label="授权保存", margin=0.1];
customer_user -- r5 [label="1"];
r5 -- face_profile [label="N"];
}
